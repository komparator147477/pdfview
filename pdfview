#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "pymupdf>=1.24.0",
# ]
# ///
"""Terminal PDF inspection and cleanup for scanned documents."""

from __future__ import annotations

import argparse
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import termios
import tty
from dataclasses import dataclass, field
from pathlib import Path

import fitz

A4 = fitz.paper_rect("a4")
IMAGE_EXTENSIONS = {
    ".bmp",
    ".gif",
    ".jfif",
    ".jp2",
    ".jpe",
    ".jpeg",
    ".jpg",
    ".jpx",
    ".pam",
    ".pbm",
    ".pgm",
    ".png",
    ".pnm",
    ".ppm",
    ".psd",
    ".tif",
    ".tiff",
}


def die(msg: str, code: int = 1) -> None:
    print(f"pdfview: {msg}", file=sys.stderr)
    raise SystemExit(code)


def chafa_format() -> str:
    term = (os.environ.get("TERM") or "").lower()
    if os.environ.get("PDFVIEW_CHAFA_FORMAT"):
        return os.environ["PDFVIEW_CHAFA_FORMAT"]
    if os.environ.get("KITTY_WINDOW_ID") or "ghostty" in term:
        return "kitty"
    if os.environ.get("TERM_PROGRAM") == "iTerm.app":
        return "iterm"
    return "symbols"


def read_key() -> str:
    if not sys.stdin.isatty():
        return sys.stdin.read(1) or "q"
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        c = sys.stdin.read(1)
        if c == "\x1b":
            extra = sys.stdin.read(2)
            return c + extra if extra else c
        return c
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def prompt(text: str) -> str:
    if sys.stdin.isatty():
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    return input(text)


def parse_pages(spec: str, total: int) -> set[int]:
    pages: set[int] = set()
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            a, b = part.split("-", 1)
            start, end = int(a), int(b)
            if start > end:
                start, end = end, start
            pages.update(range(start - 1, end))
        else:
            pages.add(int(part) - 1)
    bad = [p + 1 for p in pages if p < 0 or p >= total]
    if bad:
        raise ValueError(f"page out of range: {bad[0]}")
    return pages


def fit_rect(src: fitz.Rect, dst: fitz.Rect) -> fitz.Rect:
    scale = min(dst.width / src.width, dst.height / src.height)
    width = src.width * scale
    height = src.height * scale
    x0 = dst.x0 + (dst.width - width) / 2
    y0 = dst.y0 + (dst.height - height) / 2
    return fitz.Rect(x0, y0, x0 + width, y0 + height)


@dataclass
class Snapshot:
    id: int
    parent: int | None
    label: str
    data: bytes | None
    page: int
    selected: set[int]
    children: list[int] = field(default_factory=list)


@dataclass
class State:
    path: Path | None
    doc: fitz.Document
    out: Path
    overwrite: bool
    page: int = 0
    selected: set[int] = field(default_factory=set)
    dirty: bool = False
    message: str = ""
    history: list[str] = field(default_factory=list)
    snapshots: dict[int, Snapshot] = field(default_factory=dict)
    current_snapshot: int = 0
    saved_snapshot: int = 0
    next_snapshot: int = 1
    show_history_tree: bool = False

    def targets(self, use_selection: bool = True) -> list[int]:
        if len(self.doc) == 0:
            return []
        return sorted(self.selected) if use_selection and self.selected else [self.page]

    def clamp_page(self) -> None:
        if len(self.doc) == 0:
            self.page = 0
        else:
            self.page = max(0, min(self.page, len(self.doc) - 1))
        self.selected = {p for p in self.selected if p < len(self.doc)}


def add_history(state: State, message: str) -> None:
    state.history.append(message)
    state.history = state.history[-3:]


def doc_bytes(doc: fitz.Document) -> bytes | None:
    if len(doc) == 0:
        return None
    return doc.tobytes(garbage=4, deflate=True)


def init_snapshots(state: State) -> None:
    state.snapshots = {
        0: Snapshot(
            id=0,
            parent=None,
            label="opened" if state.path else "empty",
            data=doc_bytes(state.doc),
            page=state.page,
            selected=set(state.selected),
        )
    }
    state.current_snapshot = 0
    state.saved_snapshot = 0
    state.next_snapshot = 1


def record_snapshot(state: State, label: str) -> None:
    state.dirty = True
    add_history(state, label)
    node_id = state.next_snapshot
    state.next_snapshot += 1
    state.snapshots[node_id] = Snapshot(
        id=node_id,
        parent=state.current_snapshot,
        label=label,
        data=doc_bytes(state.doc),
        page=state.page,
        selected=set(state.selected),
    )
    state.snapshots[state.current_snapshot].children.append(node_id)
    state.current_snapshot = node_id


def restore_snapshot(state: State, node_id: int) -> None:
    if node_id not in state.snapshots:
        raise ValueError(f"history node not found: {node_id}")
    node = state.snapshots[node_id]
    old = state.doc
    state.doc = fitz.open("pdf", node.data) if node.data is not None else fitz.open()
    old.close()
    state.page = node.page
    state.selected = set(node.selected)
    state.clamp_page()
    state.current_snapshot = node_id
    state.dirty = state.current_snapshot != state.saved_snapshot
    state.show_history_tree = True


def undo(state: State) -> None:
    node = state.snapshots[state.current_snapshot]
    if node.parent is None:
        state.message = "nothing to undo"
        return
    restore_snapshot(state, node.parent)
    state.message = f"undo: {state.snapshots[state.current_snapshot].label}"
    add_history(state, state.message)


def redo(state: State) -> None:
    node = state.snapshots[state.current_snapshot]
    if not node.children:
        state.message = "nothing to redo"
        return
    child_id = node.children[-1]
    restore_snapshot(state, child_id)
    state.message = f"redo: {state.snapshots[child_id].label}"
    add_history(state, state.message)


def history_tree_line(state: State, cols: int) -> str:
    ids = sorted(state.snapshots)
    parts = []
    for node_id in ids[-8:]:
        node = state.snapshots[node_id]
        marker = "*" if node_id == state.current_snapshot else ""
        parts.append(f"{marker}{node_id}:{node.label[:18]}")
    return ("Tree: " + " | ".join(parts))[:cols]


def render_page(doc: fitz.Document, page_index: int) -> Path:
    page = doc[page_index]
    pix = page.get_pixmap(matrix=fitz.Matrix(2.0, 2.0), alpha=False)
    f = tempfile.NamedTemporaryFile(prefix="pdfview-", suffix=".png", delete=False)
    f.close()
    out = Path(f.name)
    pix.save(out)
    return out


def print_at(row: int, text: str = "", cols: int | None = None) -> None:
    if cols is not None:
        text = text[:cols]
    print(f"\033[{row};1H\033[2K{text}", end="")


def clear_line(row: int) -> None:
    print(f"\033[{row};1H\033[2K", end="")


def show(state: State, fmt: str) -> None:
    cols, rows = shutil.get_terminal_size((100, 40))
    if len(state.doc) == 0:
        print("\033[H\033[J", end="")
        dirty = "*" if state.dirty else "-"
        header = f"pdfview: empty document | selected 0 | {dirty} | out {state.out}"
        print(header[:cols])
        footer = "New: S scan, :add files | Undo: u/^Z, U, :history, :goto N | File: s save, q quit"
        if state.message:
            footer = f"{state.message} || {footer}"
            state.message = ""
        print(footer[:cols], flush=True)
        if state.history:
            print(("Recent: " + " | ".join(state.history))[:cols], flush=True)
        if state.show_history_tree:
            print(history_tree_line(state, cols), flush=True)
        return
    png = render_page(state.doc, state.page)
    try:
        footer_lines = 3 + (1 if state.history else 0) + (1 if state.show_history_tree else 0)
        footer_start = max(3, rows - footer_lines + 1)
        image_rows = max(5, footer_start - 3)
        dirty = "*" if state.dirty else "-"
        header = (
            f"{state.path.name if state.path else 'new document'} | page {state.page + 1}/{len(state.doc)} | "
            f"selected {len(state.selected)} | {dirty} | out {state.out}"
        )
        print_at(1, header, cols)
        print("\033[2;1H", end="")
        subprocess.run(
            [
                "chafa",
                "--animate=off",
                f"--format={fmt}",
                f"--size={cols}x{image_rows}",
                str(png),
            ],
            check=False,
        )
        footer_top = "Move: n/p, g/G, o go to | Select: m, :select, :clear"
        footer_bottom = "Edit: r/R rotate, M mirror, d delete, :move, c crop | Add: S scan, :add"
        footer_undo = "Undo: u/^Z, U redo, :history, :goto N | File: s save, q quit"
        if state.message:
            footer_top = f"{state.message} || {footer_top}"
            state.message = ""
        print_at(footer_start, footer_top, cols)
        print_at(footer_start + 1, footer_bottom, cols)
        print_at(footer_start + 2, footer_undo, cols)
        next_line = footer_start + 3
        if state.history:
            print_at(next_line, "Recent: " + " | ".join(state.history), cols)
            next_line += 1
        if state.show_history_tree:
            print_at(next_line, history_tree_line(state, cols), cols)
            next_line += 1
        while next_line <= rows:
            clear_line(next_line)
            next_line += 1
        print(f"\033[{rows};1H", end="", flush=True)
    finally:
        png.unlink(missing_ok=True)


def page_list_label(pages: list[int]) -> str:
    return ", ".join(str(page + 1) for page in pages)


def require_targets(targets: list[int]) -> None:
    if not targets:
        raise ValueError("no pages to edit")


def rotate(state: State, degrees: int, use_selection: bool = True) -> None:
    targets = state.targets(use_selection)
    require_targets(targets)
    for i in targets:
        page = state.doc[i]
        page.set_rotation((page.rotation + degrees) % 360)
    direction = "right" if degrees > 0 else "left"
    record_snapshot(state, f"rotate {direction}: page {page_list_label(targets)}")


def mirror(state: State, use_selection: bool = True) -> None:
    targets = state.targets(use_selection)
    require_targets(targets)
    for i in targets:
        page = state.doc[i]
        rect = page.rect
        matrix = fitz.Matrix(-2, 0, 0, 2, rect.width * 2, 0)
        pix = page.get_pixmap(matrix=matrix, alpha=False)
        state.doc.delete_page(i)
        new_page = state.doc.new_page(pno=i, width=rect.width, height=rect.height)
        new_page.insert_image(new_page.rect, pixmap=pix)
    record_snapshot(state, f"mirror: page {page_list_label(targets)}")


def delete_pages(state: State, use_selection: bool = True) -> None:
    targets = state.targets(use_selection)
    require_targets(targets)
    state.doc.delete_pages(targets)
    state.selected.clear()
    state.clamp_page()
    record_snapshot(state, f"delete: page {page_list_label(targets)}")


def move_pages(state: State, target_page_1: int, use_selection: bool = True) -> None:
    total = len(state.doc)
    targets = state.targets(use_selection)
    require_targets(targets)
    target = target_page_1 - 1
    if target < 0 or target > total:
        raise ValueError("target page out of range")
    if target in targets:
        raise ValueError("target is inside moved selection")
    new = fitz.open()
    target_ids = set(targets)
    remaining = [i for i in range(total) if i not in target_ids]
    insert_at = max(0, min(target, len(remaining)))
    order = remaining[:insert_at] + targets + remaining[insert_at:]
    for i in order:
        new.insert_pdf(state.doc, from_page=i, to_page=i)
    state.doc.close()
    state.doc = new
    state.selected.clear()
    state.page = insert_at
    record_snapshot(state, f"move page {page_list_label(targets)} before {target_page_1}")


def crop_pages(state: State, use_selection: bool = True) -> None:
    pages = state.targets(use_selection)
    require_targets(pages)
    margins = [0.0, 0.0, 0.0, 0.0]
    edge = 0
    names = ["left", "top", "right", "bottom"]
    step = 5.0
    while True:
        state.message = f"crop {names[edge]} LTRB={','.join(str(int(x)) for x in margins)}"
        show(state, chafa_format())
        c = read_key()
        if c in ("\x1b", "q"):
            state.message = "crop cancelled"
            return
        if c in ("\t",):
            edge = (edge + 1) % 4
        elif c in ("\r", "\n"):
            for i in pages:
                page = state.doc[i]
                r = page.cropbox
                nr = fitz.Rect(r.x0 + margins[0], r.y0 + margins[1], r.x1 - margins[2], r.y1 - margins[3])
                if nr.is_empty or nr.width < 10 or nr.height < 10:
                    raise ValueError("crop rectangle is too small")
                page.set_cropbox(nr)
            state.message = "crop applied"
            record_snapshot(state, f"crop: page {page_list_label(pages)}")
            return
        elif c in ("h", "j", "k", "l", "H", "J", "K", "L"):
            amount = 25.0 if c.isupper() else step
            idx = {"h": 0, "k": 1, "l": 2, "j": 3}[c.lower()]
            margins[idx] = max(0.0, margins[idx] + amount)
            edge = idx
        elif c in ("-", "_"):
            margins[edge] = max(0.0, margins[edge] - step)


def save(state: State, allow_existing: bool = False) -> None:
    out = state.path if state.overwrite else state.out
    if out is None:
        raise ValueError("no output path")
    if len(state.doc) == 0:
        raise ValueError("cannot save empty document")
    if out.exists() and out != state.path and not allow_existing:
        answer = prompt(f"{out} exists. Overwrite? [y/N] ")
        if answer.lower() != "y":
            state.message = "save cancelled"
            return
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = tempfile.NamedTemporaryFile(prefix=f".{out.name}.", suffix=".pdf", dir=out.parent, delete=False)
    tmp_path = Path(tmp.name)
    tmp.close()
    if shutil.which("qpdf"):
        try:
            state.doc.save(tmp_path, garbage=4, deflate=True)
            result = subprocess.run(["qpdf", "--check", str(tmp_path)], capture_output=True, text=True)
            if result.returncode != 0:
                details = " ".join((result.stderr or result.stdout or "unknown qpdf error").split())
                state.message = f"save failed; qpdf: {details[:120]}"
                add_history(state, "save failed: qpdf")
                return
            os.replace(tmp_path, out)
        finally:
            tmp_path.unlink(missing_ok=True)
        state.message = "saved; qpdf ok"
    else:
        try:
            state.doc.save(tmp_path, garbage=4, deflate=True)
            os.replace(tmp_path, out)
        finally:
            tmp_path.unlink(missing_ok=True)
        state.message = "saved; qpdf not found"
    state.saved_snapshot = state.current_snapshot
    state.dirty = False
    add_history(state, f"save: {out.name}")


def append_pdf(state: State, path: Path, record: bool = True) -> int:
    before = len(state.doc)
    try:
        src = fitz.open(path)
    except Exception as exc:
        raise ValueError(f"cannot open PDF: {path}: {exc}") from exc
    try:
        if not src.is_pdf:
            raise ValueError(f"PDF input required: {path}")
        if len(src) == 0:
            raise ValueError(f"empty PDF: {path}")
        state.doc.insert_pdf(src)
    finally:
        src.close()
    state.page = before
    state.clamp_page()
    if record:
        record_snapshot(state, f"add PDF: {path.name}")
    return len(state.doc) - before


def append_image(state: State, path: Path, record: bool = True) -> None:
    image = None
    converted = None
    try:
        image = fitz.open(path)
        if len(image) == 0:
            raise ValueError(f"empty image: {path}")
        converted = fitz.open("pdf", image.convert_to_pdf())
        page = state.doc.new_page(width=A4.width, height=A4.height)
        page.show_pdf_page(fit_rect(converted[0].rect, A4), converted, 0)
    except Exception as exc:
        raise ValueError(f"cannot add image: {path}: {exc}") from exc
    finally:
        if converted is not None:
            converted.close()
        if image is not None:
            image.close()
    state.page = len(state.doc) - 1
    state.clamp_page()
    if record:
        record_snapshot(state, f"add image: {path.name}")


def add_files(state: State, paths: list[str]) -> None:
    if not paths:
        raise ValueError("usage: :add image-or-pdf [...]")
    added = 0
    for raw in paths:
        path = Path(raw).expanduser().resolve()
        if not path.exists():
            raise ValueError(f"not found: {raw}")
        if not path.is_file():
            raise ValueError(f"not a file: {raw}")
        if path.suffix.lower() in IMAGE_EXTENSIONS:
            append_image(state, path, record=False)
            added += 1
        else:
            added += append_pdf(state, path, record=False)
    state.message = f"added {added} page{'s' if added != 1 else ''}"
    if added:
        record_snapshot(state, f"add: {added} page{'s' if added != 1 else ''}")


def scan_pages(state: State) -> None:
    if not shutil.which("hp-scan"):
        raise ValueError("hp-scan not found")
    total = 0
    while True:
        tmp = tempfile.NamedTemporaryFile(prefix="pdfview-scan-", suffix=".pdf", delete=False)
        tmp_path = Path(tmp.name)
        tmp.close()
        try:
            result = subprocess.run(
                ["hp-scan", "--dest=file", "--filetype=pdf", "-o", str(tmp_path)],
                check=False,
                capture_output=True,
                text=True,
            )
            if result.returncode != 0:
                details = " ".join((result.stderr or result.stdout or "no scanner details").split())
                raise ValueError(f"hp-scan failed ({result.returncode}): {details[:160]}")
            if not tmp_path.exists() or tmp_path.stat().st_size == 0:
                raise ValueError("hp-scan finished but did not create a PDF")
            total += append_pdf(state, tmp_path, record=False)
        finally:
            tmp_path.unlink(missing_ok=True)

        again = prompt("Scan another page? [y/N] ")
        if again.lower() != "y":
            break
    state.message = f"scanned {total} page{'s' if total != 1 else ''}"
    if total:
        record_snapshot(state, f"scan: {total} page{'s' if total != 1 else ''}")


def command(state: State, line: str) -> None:
    parts = shlex.split(line.strip())
    if not parts:
        return
    cmd = parts[0].lstrip(":")
    if cmd == "page" and len(parts) == 2:
        state.page = max(0, min(int(parts[1]) - 1, len(state.doc) - 1))
        add_history(state, f"go to page {state.page + 1}")
    elif cmd == "select" and len(parts) == 2:
        state.selected = parse_pages(parts[1], len(state.doc))
        add_history(state, f"select: page {page_list_label(sorted(state.selected))}")
    elif cmd == "clear":
        state.selected.clear()
        add_history(state, "clear selection")
    elif cmd == "move" and len(parts) == 2:
        move_pages(state, int(parts[1]))
    elif cmd == "scan":
        scan_pages(state)
    elif cmd == "add":
        add_files(state, parts[1:])
    elif cmd == "history":
        state.show_history_tree = not state.show_history_tree
        state.message = "history tree shown" if state.show_history_tree else "history tree hidden"
    elif cmd == "goto" and len(parts) == 2:
        restore_snapshot(state, int(parts[1]))
        state.message = f"history: moved to {state.current_snapshot}"
        add_history(state, state.message)
    else:
        state.message = f"unknown command: {line}"


def go_to_page(state: State, raw: str) -> None:
    if len(state.doc) == 0:
        raise ValueError("no pages")
    try:
        page = int(raw)
    except ValueError as exc:
        raise ValueError("page number required") from exc
    if page < 1 or page > len(state.doc):
        raise ValueError(f"page out of range: 1-{len(state.doc)}")
    state.page = page - 1
    add_history(state, f"go to page {page}")


def default_out(path: Path) -> Path:
    return path.with_name(f"{path.stem}-edited.pdf")


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(description="Terminal PDF viewer/editor for scanned PDF cleanup.")
    p.add_argument("pdf", nargs="?")
    p.add_argument("--page", type=int, default=1)
    p.add_argument("--out", type=Path)
    p.add_argument("--overwrite", action="store_true")
    p.add_argument("--format", choices=["kitty", "sixels", "iterm", "symbols"], default=None)
    args = p.parse_args(argv)

    path = Path(args.pdf).expanduser().resolve() if args.pdf else None
    if path is None:
        doc = fitz.open()
    else:
        if not path.exists():
            die(f"not found: {path}")
        if not path.is_file():
            die(f"not a file: {path}")
        try:
            doc = fitz.open(path)
        except Exception as exc:
            die(f"cannot open PDF: {exc}")
        if not doc.is_pdf:
            die("PDF input required")
        if len(doc) == 0:
            die("empty PDF")

    out = path if args.overwrite and path else (args.out.resolve() if args.out else (default_out(path) if path else Path("scan.pdf").resolve()))
    state = State(path=path, doc=doc, out=out, overwrite=args.overwrite, page=args.page - 1)
    state.clamp_page()
    init_snapshots(state)
    fmt = args.format or chafa_format()

    while True:
        if len(state.doc) > 0 and not shutil.which("chafa"):
            die("chafa is required; install it with your system package manager")
        show(state, fmt)
        c = read_key()
        try:
            if c in ("q", "\x03", "\x1b"):
                if state.dirty:
                    answer = prompt("Unsaved changes. Quit anyway? [y/N] ")
                    if answer.lower() != "y":
                        continue
                print("\033[2J\033[H", end="")
                return 0
            if c in ("n", " ", "\x1b[C"):
                if len(state.doc) > 0:
                    state.page = min(len(state.doc) - 1, state.page + 1)
            elif c in ("p", "\x1b[D"):
                state.page = max(0, state.page - 1)
            elif c == "g":
                state.page = 0
            elif c == "G":
                if len(state.doc) > 0:
                    state.page = len(state.doc) - 1
            elif c == "o":
                go_to_page(state, prompt("Go to page: "))
            elif c == "m":
                state.selected.symmetric_difference_update({state.page})
                verb = "selected" if state.page in state.selected else "unselected"
                add_history(state, f"{verb}: page {state.page + 1}")
            elif c == "r":
                rotate(state, 90, use_selection=False)
            elif c == "R":
                rotate(state, -90, use_selection=False)
            elif c == "M":
                mirror(state, use_selection=False)
            elif c == "d":
                delete_pages(state, use_selection=False)
            elif c == "c":
                crop_pages(state, use_selection=False)
            elif c == "S":
                scan_pages(state)
            elif c in ("u", "\x1a"):
                undo(state)
            elif c == "U":
                redo(state)
            elif c == "s":
                save(state)
            elif c == ":":
                command(state, prompt(":"))
        except Exception as exc:
            state.message = str(exc)


if __name__ == "__main__":
    raise SystemExit(main())
